#!/usr/bin/env python3
"""monitor-black - turn the display off immediately and ignore input for a while.

On X11 this forces DPMS off and holds an exclusive keyboard + pointer grab so
stray keystrokes or mouse bumps cannot light the screen back up. After the
lockout window expires the grabs are released and any input wakes the display.

Usage: monitor-black [SECONDS]      (default: 10)
"""

import ctypes
import ctypes.util
import os
import signal
import subprocess
import sys
import time

DEFAULT_LOCKOUT = 10.0
POLL_INTERVAL = 0.4

GRAB_MODE_ASYNC = 1
GRAB_SUCCESS = 0
CURRENT_TIME = 0
POINTER_EVENT_MASK = (1 << 2) | (1 << 3) | (1 << 6)  # button press/release + motion
DPMS_MODE_OFF = 3


def die(msg, code=1):
    print("monitor-black: " + msg, file=sys.stderr)
    sys.exit(code)


def load(name):
    path = ctypes.util.find_library(name)
    try:
        return ctypes.CDLL(path or "lib%s.so.6" % name)
    except OSError:
        return None


class Screen:
    def __init__(self):
        self.x11 = load("X11")
        if self.x11 is None:
            die("libX11 not found - this tool needs an X11 session")

        self.x11.XOpenDisplay.restype = ctypes.c_void_p
        self.x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        display_name = os.environ.get("DISPLAY")
        self.dpy = self.x11.XOpenDisplay(
            display_name.encode() if display_name else None)
        if not self.dpy:
            die("cannot open display %r (X11 session required; on Wayland run "
                "the GNOME 'Ubuntu on Xorg' session)" % (display_name or ""))

        self.x11.XDefaultRootWindow.restype = ctypes.c_ulong
        self.x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        self.root = self.x11.XDefaultRootWindow(self.dpy)

        self.x11.XGrabKeyboard.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int,
            ctypes.c_int, ctypes.c_int, ctypes.c_ulong]
        self.x11.XGrabPointer.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_uint,
            ctypes.c_int, ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong,
            ctypes.c_ulong]
        self.x11.XUngrabKeyboard.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        self.x11.XUngrabPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        self.x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.x11.XFlush.argtypes = [ctypes.c_void_p]

        self.xext = load("Xext")
        if self.xext is not None and hasattr(self.xext, "DPMSForceLevel"):
            self.xext.DPMSEnable.argtypes = [ctypes.c_void_p]
            self.xext.DPMSForceLevel.argtypes = [ctypes.c_void_p,
                                                 ctypes.c_ushort]
            self.xext.DPMSEnable(self.dpy)
            self.x11.XFlush(self.dpy)
        else:
            self.xext = None
            subprocess.call(["xset", "+dpms"])

        self.have_keyboard = False
        self.have_pointer = False

    def blank(self):
        """Force the monitor into DPMS off state."""
        if self.xext is not None:
            self.xext.DPMSForceLevel(self.dpy, DPMS_MODE_OFF)
            self.x11.XFlush(self.dpy)
        else:
            subprocess.call(["xset", "dpms", "force", "off"])

    def grab(self, deadline):
        """Take an exclusive keyboard + pointer grab, retrying until deadline.

        Another client (the GNOME overview, a menu) may hold a grab for a
        moment; blanking still works without ours, so a failure is not fatal.
        """
        while time.monotonic() < deadline:
            if not self.have_keyboard:
                ok = self.x11.XGrabKeyboard(
                    self.dpy, self.root, 0,
                    GRAB_MODE_ASYNC, GRAB_MODE_ASYNC, CURRENT_TIME)
                self.have_keyboard = (ok == GRAB_SUCCESS)
            if not self.have_pointer:
                ok = self.x11.XGrabPointer(
                    self.dpy, self.root, 0, POINTER_EVENT_MASK,
                    GRAB_MODE_ASYNC, GRAB_MODE_ASYNC, 0, 0, CURRENT_TIME)
                self.have_pointer = (ok == GRAB_SUCCESS)
            if self.have_keyboard and self.have_pointer:
                return True
            time.sleep(0.05)
        return self.have_keyboard and self.have_pointer

    def discard_input(self):
        """Throw away everything the grab collected so nothing replays later."""
        self.x11.XSync(self.dpy, 1)

    def release(self):
        if self.have_keyboard:
            self.x11.XUngrabKeyboard(self.dpy, CURRENT_TIME)
            self.have_keyboard = False
        if self.have_pointer:
            self.x11.XUngrabPointer(self.dpy, CURRENT_TIME)
            self.have_pointer = False
        self.discard_input()


def main():
    args = [a for a in sys.argv[1:] if a not in ("-h", "--help")]
    if len(args) != len(sys.argv[1:]):
        print(__doc__)
        return 0
    lockout = DEFAULT_LOCKOUT
    if args:
        try:
            lockout = max(0.0, float(args[0]))
        except ValueError:
            die("SECONDS must be a number, got %r" % args[0], 2)

    screen = Screen()
    # Blank first, grab second: the screen goes dark with no perceptible delay.
    screen.blank()

    deadline = time.monotonic() + lockout
    screen.grab(min(deadline, time.monotonic() + 1.0))

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))

    try:
        while time.monotonic() < deadline:
            # Input still resets the X server's DPMS timer even while grabbed,
            # so keep re-asserting the off state for the whole lockout.
            screen.blank()
            screen.discard_input()
            time.sleep(POLL_INTERVAL)
    finally:
        screen.release()
    return 0


if __name__ == "__main__":
    sys.exit(main())
